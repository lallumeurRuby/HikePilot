# 本專案未載入 python-dotenv，此檔案僅供文件參考；
# 實際執行時請透過真正的環境變數（shell、IDE run config、process manager）設定這些值。

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/hikepilot_backend_dev

# JWT_SECRET 在共用/staging/正式環境務必換成高強度亂數值，不要使用預設的開發用值。
JWT_SECRET=test-secret-key

# 必須與 Google Cloud Console 建立的 OAuth Client ID 一致，
# 且必須與前端的 NEXT_PUBLIC_GOOGLE_CLIENT_ID 相同，否則登入會回 INVALID_GOOGLE_TOKEN。
GOOGLE_CLIENT_ID=69643561029-f5ie6sml0flg7cjjf9hjtd9a2pe78jns.apps.googleusercontent.com
